{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm run look:*)",
      "Bash(npm run map:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(python3 -)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Read(./dist/**)",
      "Read(./package-lock.json)"
    ]
  },
  "model": "opusplan"
}
